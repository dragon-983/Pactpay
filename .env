# PactPay Environment Configuration

# Server
PORT=3002
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql:///pactpay?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql:///pactpay_test?host=/var/run/postgresql
DATABASE_SSL=false

# Stellar Testnet Network & RPC
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban Escrow Contract ID (populated after contract deployment to Testnet)
ESCROW_CONTRACT_ID=

# Native Stellar Asset Contract (SAC) on Testnet
NATIVE_TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Platform Arbiter Stellar Public Key
PLATFORM_ARBITER_ADDRESS=GDG2Y3KGYX465W2MDT34D7EQ54D2V33GZZUWWF5FGLA2X44S7W67O274
